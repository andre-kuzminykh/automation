{
  "hedra": {
    "api_base": "https://api.hedra.com/web-app/public",
    "model": "Hedra Avatar 540p",
    "resolution": "540p",
    "aspect_ratio": "1:1",
    "voice_id": "aisala",
    "duration_per_slide_seconds_max": 120,
    "api_key_env": "HEDRA_API_KEY"
  },
  "avatar_image": {
    "source_url": "https://i.ibb.co/VcCKP5Kg/photo-2026-05-18-01-41-54.jpg",
    "local_path": "data/avatar.jpg",
    "filename": "avatar.jpg"
  },
  "input": {
    "slides_file": "data/slides.json"
  },
  "output": {
    "videos_dir": "videos",
    "filename_pattern": "{id}.mp4",
    "manifest_file": "data/manifest.json"
  },
  "gcloud": {
    "instance": "human-1",
    "project": "i-crossbar-433120-v3",
    "zone": "europe-west1-b",
    "ssh_command": "gcloud compute ssh human-1 --project=i-crossbar-433120-v3 --zone=europe-west1-b"
  },
  "git": {
    "repo": "andre-kuzminykh/automation",
    "branch": "claude/setup-gcloud-video-service-XKVf0",
    "videos_dir_in_repo": "l7/videos"
  }
}
